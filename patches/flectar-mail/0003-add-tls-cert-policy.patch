+    /// Try to capture the server's untrusted certificate for a TOFU dialog,
+    /// after the real connection already failed.
+    async fn capture_tls_certificate(
+        &self,
+        args: &AddPasswordAccountArgs,
+    ) -> Option<UntrustedCertificate> {
+        use crate::net::tls::cert_policy::CertificateInfo;
+
+        // Only attempt capture for IMAP/POP3 (JMAP and Gmail use HTTP).
+        let host = match args.mail_protocol {
+            MailProtocol::Imap => Some(&args.incoming_host),
+            MailProtocol::Pop3 => Some(&args.incoming_host),
+            _ => None,
+        }?;
+        let port = args.incoming_port;
+
+        // Connect a raw TCP + TLS with a capturing verifier.
+        let tcp = crate::net::connect_tcp(host, port).await.ok()?;
+        let (connector, capture) = crate::net::tls::connector_with_capture(
+            &args.connection.trusted_certificate_pem,
+            &args.connection.cert_policy(),
+        )
+        .ok()?;
+        let _ = crate::net::tls::handshake(&connector, tcp, host).await;
+        let failed = capture.take_captured()?;
+
+        let info = CertificateInfo::from_der(&failed.end_entity, &failed.to_pem_bundle()).ok()?;
+
+        Some(UntrustedCertificate {
+            host: failed.host,
+            pem: info.pem,
+            sha256_fingerprint: info.sha256_fingerprint,
+            spki_sha256_fingerprint: info.spki_sha256_fingerprint,
+        })
+    }
