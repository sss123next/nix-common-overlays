diff --git a/ui/certificate-verification.slint b/ui/certificate-verification.slint
new file mode 100644
index 0000000..442af54
--- /dev/null
+++ b/ui/certificate-verification.slint
@@ -0,0 +1,24 @@
+// Certificate verification TOFU dialog state.  When a server presents an
+// untrusted or otherwise invalid TLS certificate during account setup, the
+// properties here carry its details and the callbacks report the user's
+// decision (src/mail_setup.rs).
+export global CertVerification {
+    // Whether the dialog is shown.
+    in-out property <bool> visible;
+    // The server hostname that presented the certificate.
+    in property <string> host;
+    // SHA-256 fingerprint of the DER certificate (hex).
+    in property <string> sha256_fingerprint;
+    // SHA-256 SPKI fingerprint for pinning (hex).
+    in property <string> spki_fingerprint;
+    // PEM-encoded end-entity certificate.
+    in property <string> pem;
+    // Human-readable summary of problems found with this certificate.
+    in property <string> problems;
+
+    // User decisions:
+    callback accept_once();    // Trust for this session only.
+    callback accept_always();  // Save to known certificates.
+    callback pin();            // Save and pin SPKI fingerprint.
+    callback reject();         // Do not connect.
+}
