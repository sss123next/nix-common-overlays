+        border-radius: 14px;
+        border-width: 1px;
+        border-color: AppTheme.control-border;
+        background: AppTheme.surface;
+        clip: true;
+
+        dialog-focus := FocusScope {
+            capture-key-pressed(event) => {
+                if event.text == Key.Escape {
+                    CertVerification.visible = false;
+                    CertVerification.reject();
+                    return accept;
+                }
+                reject
+            }
+
+            VerticalBox {
+                padding: 24px;
+                spacing: 12px;
+
+                Text {
+                    text: @tr("Certificate verification required");
+                    color: AppTheme.heading;
+                    font-size: TypeScale.title-large;
+                    font-weight: 600;
+                }
+                Text {
+                    text: @tr("The server's TLS certificate could not be verified.");
+                    color: AppTheme.secondary;
+                    font-size: TypeScale.body;
+                    wrap: word-wrap;
+                }
+
+                // Problems summary
+                if CertVerification.problems != "" : Rectangle {
+                    border-radius: 8px;
+                    background: AppTheme.destructive.transparentize(0.88);
+                    border-width: 1px;
+                    border-color: AppTheme.destructive.transparentize(0.4);
+                    VerticalBox {
+                        x: 12px;
+                        y: 12px;
+                        width: parent.width - 24px;
+                        height: parent.height - 24px;
+                        Text {
+                            text: CertVerification.problems;
+                            color: AppTheme.destructive;
+                            font-size: TypeScale.caption;
+                            wrap: word-wrap;
+                        }
+                    }
+                }
+
+                // Certificate details
+                ScrollView {
+                    vertical-stretch: 1;
+                    VerticalBox {
+                        padding: 0px;
+                        padding-right: 12px;
+                        spacing: 8px;
+
+                        Text {
+                            text: @tr("Server: {}",
+                                CertVerification.host != "" ? CertVerification.host : @tr("(unknown)"));
+                            color: AppTheme.heading;
+                            font-size: TypeScale.body;
+                            font-weight: 600;
+                            wrap: word-wrap;
+                        }
+
+                        HorizontalBox {
+                            spacing: 4px;
+                            Text {
+                                text: @tr("SHA-256 fingerprint:");
+                                color: AppTheme.secondary;
+                                font-size: TypeScale.secondary;
+                            }
+                            Text {
+                                text: CertVerification.sha256_fingerprint;
+                                color: AppTheme.body;
+                                font-size: TypeScale.caption;
+                                font-family: "monospace";
+                                wrap: word-wrap;
+                            }
+                        }
+
+                        HorizontalBox {
+                            spacing: 4px;
+                            Text {
+                                text: @tr("SPKI fingerprint:");
+                                color: AppTheme.secondary;
+                                font-size: TypeScale.secondary;
+                            }
+                            Text {
+                                text: CertVerification.spki_fingerprint;
+                                color: AppTheme.body;
+                                font-size: TypeScale.caption;
+                                font-family: "monospace";
+                                wrap: word-wrap;
+                            }
+                        }
+
+                        Text {
+                            text: @tr("Verify the fingerprints above with your server administrator before trusting this certificate.");
+                            color: AppTheme.muted;
+                            font-size: TypeScale.caption;
+                            wrap: word-wrap;
+                        }
+
+                        Text {
+                            text: @tr("What would you like to do with this certificate?");
+                            color: AppTheme.heading;
+                            font-size: TypeScale.body;
+                            font-weight: 600;
+                            wrap: word-wrap;
+                        }
+                    }
+                }
+
+                // Buttons
+                VerticalBox {
+                    spacing: 8px;
+
+                    Button {
+                        height: 40px;
+                        text: @tr("Accept once (this session only)");
+                        clicked => {
+                            CertVerification.visible = false;
+                            CertVerification.accept_once();
+                        }
+                    }
+                    Button {
+                        height: 40px;
+                        text: @tr("Accept always (save to trusted certificates)");
+                        primary: true;
+                        clicked => {
+                            CertVerification.visible = false;
+                            CertVerification.accept_always();
+                        }
+                    }
+                    Button {
+                        height: 40px;
+                        text: @tr("Pin certificate (verify exact certificate)");
+                        clicked => {
+                            CertVerification.visible = false;
+                            CertVerification.pin();
+                        }
+                    }
+                    Button {
+                        height: 40px;
+                        text: @tr("Reject");
+                        clicked => {
+                            CertVerification.visible = false;
+                            CertVerification.reject();
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
