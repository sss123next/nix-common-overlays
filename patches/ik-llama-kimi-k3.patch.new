@@ -1351,14 +1357,39 @@
 }
 
 // for backwards compatibility, does not support ggml-backend
+// For F8_E4M3 conversion on load
+static inline float f8_e4m3_to_f32(uint8_t bits) {
+    const uint8_t ax = bits & 0x7F;
+    if (ax == 0x7F) { return NAN; }
+    const int exp = (ax >> 3) & 0xF;
+    const int man = ax & 0x7;
+    const float value = exp == 0
+        ? ldexpf((float) man, -9)
+        : ldexpf(1.0f + (float) man / 8.0f, exp - 7);
+    return bits & 0x80 ? -value : value;
+}
+
 void llama_model_loader::load_data_for(struct ggml_tensor * cur) const {
     const auto & w = require_weight(ggml_get_name(cur));
+    const enum ggml_type file_type = w.tensor->type;
+    const bool is_f8 = (file_type == GGML_TYPE_F8_E4M3);
 
     if (!w.nvfp4_scale.empty()) {
         read_nvfp4_rows(w, *files.at(w.idx), cur, (uint8_t *) cur->data, 0, ggml_nrows(cur));
     } else if (use_mmap) {
         const auto & mapping = mappings.at(w.idx);
-        if (cur->data == nullptr) {
+        if (is_f8) {
+            // F8_E4M3 → F32: cannot mmap directly (size mismatch). Must have buffer.
+            GGML_ASSERT(cur->data != nullptr);
+            const size_t nbytes_f8 = ggml_nelements(cur) * 1;
+            memcpy(cur->data, (uint8_t *)mapping->addr() + w.offs, nbytes_f8);
+            const int64_t n = ggml_nelements(cur);
+            const uint8_t * src = (const uint8_t *)cur->data;
+            float * dst = (float *)cur->data;
+            for (int64_t i = n - 1; i >= 0; --i) {
+                dst[i] = f8_e4m3_to_f32(src[i]);
+            }
+        } else if (cur->data == nullptr) {
             cur->data = (uint8_t *)mapping->addr() + w.offs;
         } else {
             memcpy(cur->data, (uint8_t *)mapping->addr() + w.offs, ggml_nbytes(cur));
@@ -1367,8 +1398,21 @@
