 #endif
 
+    // Periodic per-slot stats (see gpt_params::log_stats_interval), emitted to stderr through
+    // common_log, like the per-request timing stats. Printed from a dedicated thread, so that
+    // the rows keep their cadence even while the queue thread is busy inside llama_decode()
+    // (a single prompt chunk can take minutes on a large context).
+    std::atomic<bool> stats_stop{false};
+    std::thread stats_thread;
+    if (params.log_stats_interval > 0) {
+        const int64_t interval_ms = params.log_stats_interval * 1000;
+        stats_thread = std::thread([&]() {
+            while (!stats_stop.load() && state.load() == SERVER_STATE_READY) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(interval_ms));
+                if (stats_stop.load()) {
+                    break;
+                }
+                ctx_server.print_periodic_stats();
+            }
+        });
+    }
+
+    // note: start_loop() blocks until the queue is terminated, so it must come last
     ctx_server.queue_tasks.start_loop();
 
     svr->stop();
     t.join();
 
+    // stop the periodic stats thread and wait for it before main's locals go out of scope
+    stats_stop.store(true);
+    if (stats_thread.joinable()) {
+        stats_thread.join();
+    }
+
     llama_backend_free();
 
     return 0;
