     return true;
 }
+
+// ======================== FP8 E4M3 (OCP) ========================
+
+void quantize_row_f8_e4m3_ref(const float * GGML_RESTRICT x, ggml_fp8_e4m3_t * GGML_RESTRICT y, int64_t k) {
+    for (int64_t i = 0; i < k; ++i) {
+        y[i].bits = ggml_fp32_to_f8_e4m3(x[i]);
+    }
+}
+
+void quantize_row_f8_e4m3(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t k) {
+    quantize_row_f8_e4m3_ref(x, (ggml_fp8_e4m3_t *)y, k);
+}
+
+size_t quantize_f8_e4m3(const float * GGML_RESTRICT src, void * GGML_RESTRICT dst, int64_t nrows, int64_t n_per_row, const float * imatrix, const struct quantize_user_data * use_data) {
+    GGML_UNUSED(imatrix);
+    GGML_UNUSED(use_data);
+    quantize_row_f8_e4m3_ref(src, (ggml_fp8_e4m3_t *)dst, nrows * n_per_row);
+    return nrows * n_per_row * sizeof(ggml_fp8_e4m3_t);
+}
+
+void dequantize_row_f8_e4m3(const ggml_fp8_e4m3_t * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    for (int64_t i = 0; i < k; ++i) {
+        y[i] = ggml_f8_e4m3_to_fp32(x[i].bits);
+    }
+}
