[32m+[m[32m        printf("Adding custom rule %s -> %s\n", pattern.c_str(), ggml_type_name(type));[m
[32m+[m[32m        custom_quants.emplace_back(std::move(pattern), type);[m
[32m+[m[32m    }[m
[32m+[m[32m    return true;[m
[32m+[m[32m}[m
