+                usage(argv[0]);
+            }
+        } else if (strcmp(argv[arg_idx], "--per-layer-token-embedding-type") == 0) {
+            if (arg_idx < argc-1) {
+                params.per_layer_token_embedding_type = parse_ggml_type(argv[++arg_idx]);
