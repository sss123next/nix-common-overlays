[32m+[m[32mstatic int prepare_imatrix(const std::string & imatrix_file,[m
[32m+[m[32m        std::string & imatrix_dataset,[m
[32m+[m[32m        const std::vector<std::string> & included_weights,[m
[32m+[m[32m        const std::vector<std::string> & excluded_weights,[m
