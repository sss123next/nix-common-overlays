[32m+[m[32m// Parse a common-style CUDA list (CUDA0,CUDA1, bare index ok) into ordinals.[m
[32m+[m[32mstatic bool parse_cuda_device_list(const std::string & arg, std::vector<int> & devs) {[m
[32m+[m[32m    std::vector<int> out;[m
[32m+[m[32m    for (const auto & item : string_split<std::string>(arg, ',')) {[m
[32m+[m[32m        size_t beg = item.find_first_not_of(" \t");[m
[32m+[m[32m        size_t end = item.find_last_not_of(" \t");[m
[32m+[m[32m        if (beg == std::string::npos) {[m
[32m+[m[32m            return false;[m
[32m+[m[32m        }[m
[32m+[m[32m        std::string first = item.substr(beg, end - beg + 1);[m
[32m+[m[32m        std::string digits = first;[m
[32m+[m[32m        if (first.size() > 4 && (first.compare(0, 4, "CUDA") == 0 || first.compare(0, 4, "cuda") == 0)) {[m
[32m+[m[32m            digits = first.substr(4);[m
[32m+[m[32m        }[m
[32m+[m[32m        if (digits.empty()) {[m
[32m+[m[32m            return false;[m
[32m+[m[32m        }[m
[32m+[m[32m        for (char c : digits) {[m
[32m+[m[32m            if (!isdigit((unsigned char) c)) {[m
[32m+[m[32m                return false;[m
[32m+[m[32m            }[m
[32m+[m[32m        }[m
[32m+[m[32m        try {[m
[32m+[m[32m            out.push_back(std::stoi(digits));[m
[32m+[m[32m        }[m
[32m+[m[32m        catch (const std::exception &) {[m
[32m+[m[32m            return false;[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m[32m    if (out.empty()) {[m
[32m+[m[32m        return false;[m
[32m+[m[32m    }[m
[32m+[m[32m    devs = std::move(out);[m
[32m+[m[32m    return true;[m
[32m+[m[32m}[m
