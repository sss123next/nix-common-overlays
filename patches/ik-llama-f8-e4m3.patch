[32m+[m[32m            exit(1);[m
[32m+[m[32m        }[m
[32m+[m[32m        name_as_vec[len] = 0;[m
[32m+[m[32m        std::string name{name_as_vec.data()};[m
[32m+[m[32m        auto & e = imatrix_data[name];[m
[32m+[m[32m        int ncall;[m
