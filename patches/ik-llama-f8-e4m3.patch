[32m+[m[32m        e.resize(nval);[m
[32m+[m[32m        in.read((char *)e.data(), nval*sizeof(float));[m
[32m+[m[32m        if (in.fail()) {[m
[32m+[m[32m            printf("%s: failed reading data for entry %d\n", __func__, i);[m
[32m+[m[32m            imatrix_data = {};[m
[32m+[m[32m            exit(1);[m
[32m+[m[32m        }[m
[32m+[m[32m        if (ncall > 0) {[m
[32m+[m[32m            for (auto& v : e) v /= ncall;[m
[32m+[m[32m        }[m
[32m+[m
[32m+[m[32m        if (getenv("LLAMA_TRACE")) {[m
[32m+[m[32m            printf("%s: loaded data (size = %6d, ncall = %6d) for '%s'\n", __func__, int(e.size()), ncall, name.c_str());[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    // latest imatrix version contains the dataset filename at the end of the file[m
[32m+[m[32m    int m_last_call = 0;[m
[32m+[m[32m    if (in.peek() != EOF) {[m
[32m+[m[32m        in.read((char *)&m_last_call, sizeof(m_last_call));[m
[32m+[m[32m        int dataset_len;[m
[32m+[m[32m        in.read((char *)&dataset_len, sizeof(dataset_len));[m
[32m+[m[32m        std::vector<char> dataset_as_vec(dataset_len);[m
[32m+[m[32m        in.read(dataset_as_vec.data(), dataset_len);[m
[32m+[m[32m        imatrix_dataset.assign(dataset_as_vec.begin(), dataset_as_vec.end());[m
