[32m+[m[32m    }[m
[32m+[m[32m    if (imatrix_data.empty()) {[m
[32m+[m[32m        return m_last_call;[m
[32m+[m[32m    }[m
[32m+[m[32m    if (!excluded_weights.empty()) {[m
[32m+[m[32m        for (auto& name : excluded_weights) {[m
[32m+[m[32m            for (auto it = imatrix_data.begin(); it != imatrix_data.end(); ) {[m
[32m+[m[32m                auto pos = it->first.find(name);[m
[32m+[m[32m                if (pos != std::string::npos) it = imatrix_data.erase(it);[m
[32m+[m[32m                else ++it;[m
[32m+[m[32m            }[m
