[32m+[m[32mstatic ggml_type parse_ggml_type(const char * arg) {[m
[32m+[m[32m    ggml_type result = GGML_TYPE_COUNT;[m
[32m+[m[32m    std::string arg_lower{arg};[m
[32m+[m[32m    for (auto & c : arg_lower) c = std::tolower(c);[m
[32m+[m[32m    for (int j = 0; j < GGML_TYPE_COUNT; ++j) {[m
[32m+[m[32m        auto type = ggml_type(j);[m
[32m+[m[32m        const auto * name = ggml_type_name(type);[m
[32m+[m[32m        if (name) {[m
[32m+[m[32m            if (strcmp(arg, name) == 0) return type;[m
[32m+[m[32m            std::string name_lower{name};[m
[32m+[m[32m            for (auto & c : name_lower) c = std::tolower(c);[m
[32m+[m[32m            if (name_lower == arg_lower) return type;[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m[32m    return result;[m
[32m+[m[32m}[m
