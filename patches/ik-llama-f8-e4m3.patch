[32m+[m[32m    }[m
[32m+[m[32m    if (!included_weights.empty()) {[m
[32m+[m[32m        std::unordered_map<std::string, std::vector<float>> tmp;[m
[32m+[m[32m        for (auto& name : included_weights) {[m
[32m+[m[32m            for (auto& e : imatrix_data) {[m
[32m+[m[32m                auto pos = e.first.find(name);[m
[32m+[m[32m                if (pos != std::string::npos) {[m
[32m+[m[32m                    tmp.emplace(std::move(e));[m
[32m+[m[32m                }[m
[32m+[m[32m            }[m
[32m+[m[32m        }[m
[32m+[m[32m        imatrix_data = std::move(tmp);[m
[32m+[m[32m    }[m
[32m+[m[32m    if (!imatrix_data.empty()) {[m
[32m+[m[32m        printf("%s: have %d importance matrix entries\n", __func__, int(imatrix_data.size()));[m
[32m+[m[32m    }[m
[32m+[m[32m    return m_last_call;[m
[32m+[m[32m}[m
