+        const double sdx = e->data.mouse_scroll.dx;
+        const double sdy = e->data.mouse_scroll.dy;
+        const double adx = sdx < 0 ? -sdx : sdx;
+        const double ady = sdy < 0 ? -sdy : sdy;
+        const char *wheel = NULL;
+        if (sdy != 0.0 && ady >= adx) {
+          wheel = sdy < 0 ? "WheelUp" : "WheelDown";
+        } else if (sdx != 0.0) {
+          wheel = sdx < 0 ? "WheelLeft" : "WheelRight";
