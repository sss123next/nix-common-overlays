@@ -445,6 +445,34 @@ static void key_handler(struct imv *imv, const struct imv_event *event)
 }
 
 
+/* Bindable name for a mouse button, accepting both X11 core button numbers
+ * and Wayland (evdev) BTN_* codes, or NULL if the button is not bindable. */
+static const char *mouse_button_name(int button)
+{
+  /* NB: names are prefixed with "Mouse" deliberately -- bare "Left"/"Right"
+   * would collide with the arrow keys' descriptions in the shared bind
+   * table, and "Back"/"Forward" with the XF86 browser keysyms. */
+  switch(button) {
+    /* X11 core pointer buttons (4/5 are delivered as scroll events) */
+    case 1: return "MouseLeft";
+    case 2: return "MouseMiddle";
+    case 3: return "MouseRight";
+    case 6: return "MouseForward";
+    case 7: return "MouseBack";
+    case 8: return "MouseSide";
+    case 9: return "MouseExtra";
+    /* Wayland: evdev BTN_* codes */
+    case 0x110: return "MouseLeft";    /* BTN_LEFT */
+    case 0x111: return "MouseRight";   /* BTN_RIGHT */
+    case 0x112: return "MouseMiddle";  /* BTN_MIDDLE */
+    case 0x113: return "MouseSide";    /* BTN_SIDE */
+    case 0x114: return "MouseExtra";   /* BTN_EXTRA */
+    case 0x115: return "MouseForward"; /* BTN_FORWARD */
+    case 0x116: return "MouseBack";    /* BTN_BACK */
+  }
+  return NULL;
+}
