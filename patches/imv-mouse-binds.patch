 {
   struct imv *imv = data;
@@ -471,8 +499,45 @@ static void event_handler(void *data, const struct imv_event *e)
             e->data.mouse_motion.dy, imv->current_image);
       }
       break;
+    case IMV_EVENT_MOUSE_BUTTON:
+      {
+        const char *button = mouse_button_name(e->data.mouse_button.button);
+        if (button && e->data.mouse_button.pressed) {
+          const char *mods = e->data.mouse_button.mods ? e->data.mouse_button.mods : "";
+          char name[128];
+          snprintf(name, sizeof name, "%s%s", mods, button);
+          struct list *cmds = imv_bind_handle_event(imv->binds, name);
+          if (cmds) {
+            imv_command_exec_list(imv->commands, cmds, imv);
+          }
+        }
+      }
+      break;
     case IMV_EVENT_MOUSE_SCROLL:
       {
+        /* Bindable as WheelUp/WheelDown/WheelLeft/WheelRight (optionally with
+         * modifiers); fall back to the default cursor-centred zoom when
+         * nothing is bound. */
+        const double sdx = e->data.mouse_scroll.dx;
+        const double sdy = e->data.mouse_scroll.dy;
+        const double adx = sdx < 0 ? -sdx : sdx;
+        const double ady = sdy < 0 ? -sdy : sdy;
+        const char *wheel = NULL;
+        if (sdy != 0.0 && ady >= adx) {
+          wheel = sdy < 0 ? "WheelUp" : "WheelDown";
+        } else if (sdx != 0.0) {
+          wheel = sdx < 0 ? "WheelLeft" : "WheelRight";
+        }
+        if (wheel) {
+          const char *mods = e->data.mouse_scroll.mods ? e->data.mouse_scroll.mods : "";
+          char name[128];
+          snprintf(name, sizeof name, "%s%s", mods, wheel);
+          struct list *cmds = imv_bind_handle_event(imv->binds, name);
+          if (cmds) {
+            imv_command_exec_list(imv->commands, cmds, imv);
+            break;
+          }
+        }
         double x, y;
         imv_window_get_mouse_position(imv->window, &x, &y);
         imv_viewport_zoom(imv->view, imv->current_image, IMV_ZOOM_MOUSE,
