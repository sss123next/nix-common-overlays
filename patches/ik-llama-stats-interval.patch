+void server_slot::print_timings_tg() {
+    if (!print_stats) return;
+
+    // only print if we have enough decoded tokens
+    if (n_decoded < 100) {
+        return;
+    }
+
+    const int64_t t_now = ggml_time_us();
+
+    // throttle: at most once per 3 seconds
+    if (t_now - t_print_last < 3 * 1000 * 1000) {
+        return;
+    }
+
+    const double n_gen_second = t_token_generation > 0.0
+        ? 1e3 / t_token_generation * n_decoded
+        : 0.0;
+    const double n_gen_second_win = t_now > t_print_last
+        ? 1e6 / (double)(t_now - t_print_last) * (n_decoded - n_gen_last)
+        : 0.0;
+
+    t_print_last = t_now;
+    n_gen_last = n_decoded;
+
+    SLT_INF(*this, "n_gen = %6d, tg = %6.2f t/s, tg_3s = %6.2f t/s\n",
+        (int)n_decoded, n_gen_second, n_gen_second_win);
+}
+
+void server_slot::print_timings_pp() const {
+    if (!print_stats) return;
+
+    // only report while the prompt is still being processed (t_start_generation is
+    // 0 until the first token has been decoded, i.e. prompt processing has finished)
+    if (t_start_process_prompt == 0 || t_start_generation != 0) {
+        return;
+    }
+
+    // t_prompt_processing is only finalized once generation starts, so measure the
+    // elapsed time directly from the moment prompt processing began
+    const double t_prompt_total = (double)(ggml_time_us() - t_start_process_prompt) / 1e3; // ms
+
+    // only print if prompt processing takes more than 3 seconds
+    if (t_prompt_total < 3000.0) {
+        return;
+    }
+
+    const double n_prompt_second = t_prompt_total > 0.0
+        ? 1e3 / t_prompt_total * n_prompt_tokens_processed
+        : 0.0;
+    const double f_progress = n_prompt_tokens > 0
+        ? (double)n_prompt_tokens_processed / n_prompt_tokens
+        : 0.0;
+
+    SLT_INF(*this, "prompt processing, n_tokens = %6d, progress = %.2f, t = %6.2f s / %.2f tokens per second\n",
+        (int)n_prompt_tokens_processed, f_progress, t_prompt_total / 1e3, n_prompt_second);
+}
+
 void server_metrics::init() {
     t_start = ggml_time_us();
 }
