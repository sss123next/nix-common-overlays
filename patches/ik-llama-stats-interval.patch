diff --git a/examples/server/server.cpp b/examples/server/server.cpp
index 0c13f833..005e4a46 100644
--- a/examples/server/server.cpp
+++ b/examples/server/server.cpp
@@ -2364,9 +2364,48 @@ int main(int argc, char ** argv) {
 
     ctx_server.queue_tasks.start_loop();
 
+    // Periodic throughput stats (see gpt_params::log_stats_interval), emitted to stderr
+    // through common_log, like the per-request timing stats.
+    std::atomic<bool> stats_stop{false};
+    std::thread stats_thread;
+    if (params.log_stats_interval > 0) {
+        const int64_t interval_ms = params.log_stats_interval * 1000;
+        stats_thread = std::thread([&]() {
+            double   prev_us     = ggml_time_us();
+            uint64_t prev_prompt = ctx_server.metrics.n_prompt_tokens_processed_total;
+            uint64_t prev_gen    = ctx_server.metrics.n_tokens_predicted_total;
+            while (!stats_stop.load() && state.load() == SERVER_STATE_READY) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(interval_ms));
+                if (stats_stop.load()) {
+                    break;
+                }
+                double now_us  = ggml_time_us();
+                double dt      = (now_us - prev_us) / 1e6;
+                uint64_t cur_p = ctx_server.metrics.n_prompt_tokens_processed_total;
+                uint64_t cur_g = ctx_server.metrics.n_tokens_predicted_total;
+                if (dt > 0.0) {
+                    LOG_INF("\n=== PERIODIC STATS (%.1f s) === prompt_tok/s: %.1f, predicted_tok/s: %.1f, elapsed: %.1f s\n",
+                        dt,
+                        (cur_p - prev_prompt) / dt,
+                        (cur_g - prev_gen) / dt,
+                        dt);
+                }
+                prev_us    = now_us;
+                prev_prompt = cur_p;
+                prev_gen   = cur_g;
+            }
+        });
+    }
+
     svr->stop();
     t.join();
 
+    // stop the periodic stats thread and wait for it before main's locals go out of scope
+    stats_stop.store(true);
+    if (stats_thread.joinable()) {
+        stats_thread.join();
+    }
+
     llama_backend_free();
 
     return 0;
