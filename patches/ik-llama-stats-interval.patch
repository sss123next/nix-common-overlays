+// Periodic per-slot stats (gpt_params::log_stats_interval). The queue thread publishes
+// snapshots (it is the only thread allowed to touch server_slot), the stats thread prints
+// them at the requested interval, so that the rows keep their cadence even while the queue
+// thread is blocked inside llama_decode().
+enum slot_stats_phase {
+    SLOT_STATS_IDLE,
+    SLOT_STATS_PROMPT,
+    SLOT_STATS_GENERATION,
+};
+
+struct slot_stats_snapshot {
+    slot_stats_phase phase = SLOT_STATS_IDLE;
+    int32_t id            = -1;
+    int32_t task_id       = -1;
+    int32_t n_prompt_tokens         = 0;
+    int32_t n_prompt_tokens_decoded = 0; // prompt tokens whose decode has completed
+    int32_t n_decoded               = 0;
+    int64_t t_start_process_prompt  = 0;
+    int64_t t_start_generation      = 0;
+};
+
+// per-slot bookkeeping of the stats thread (the tg_<interval>s column)
+struct slot_stats_window {
+    bool    in_generation = false;
+    int64_t t_last        = 0;
+    int32_t n_gen_last    = 0;
+};
