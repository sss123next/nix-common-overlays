+// Rows of the periodic stats (see gpt_params::log_stats_interval). The wording follows the
+// upstream llama.cpp rows; the field widths are fixed and wide enough for the values met in
+// practice (token counts up to millions, times/throughputs up to the tens of thousands), so
+// that consecutive rows of a request line up into a stable table.
+
+static std::string stats_row_prompt_processing(int32_t n_tokens, int32_t n_prompt_tokens, int64_t t_elapsed_us) {
+    const double t_elapsed = (double) t_elapsed_us / 1e6;
+    const double progress  = n_prompt_tokens > 0 ? (double) n_tokens / n_prompt_tokens : 0.0;
+    const double n_second  = t_elapsed > 0.0 ? n_tokens / t_elapsed : 0.0;
+
+    char buf[256];
+    snprintf(buf, sizeof(buf),
+        "prompt processing, n_tokens = %7d, progress = %6.2f, t = %8.2f s / %8.2f tokens per second",
+        (int) n_tokens, progress, t_elapsed, n_second);
+    return std::string(buf);
+}
+
+static std::string stats_row_generation(int32_t n_gen, double t_gen_s, double n_gen_second_win, int32_t interval_s) {
+    const double n_gen_second = t_gen_s > 0.0 ? n_gen / t_gen_s : 0.0;
+
+    char buf[256];
+    snprintf(buf, sizeof(buf),
+        "n_gen = %7d, tg = %8.2f t/s, tg_%ds = %8.2f t/s",
+        (int) n_gen, n_gen_second, (int) interval_s, n_gen_second_win);
+    return std::string(buf);
+}
+
+// Same prefix as SLT_INF(), but with the task id passed by value: the periodic stats thread
+// must not dereference slot.task, which the queue thread may free at any moment.
+static void log_stats_row(const char * fn, int32_t id, int32_t id_task, const std::string & row) {
+    LOG_INF("slot %12.*s: id %2d | task %d | %s\n", 12, fn, id, id_task, row.c_str());
+}
+
+void server_slot::print_timings_pp() const {
+    if (!print_stats || stats_interval <= 0) return;
+
+    // only report while the prompt is still being processed (t_start_generation is
+    // 0 until the first token has been decoded, i.e. prompt processing has finished)
+    if (t_start_process_prompt == 0 || t_start_generation != 0) {
+        return;
+    }
+
+    // t_prompt_processing is only finalized once generation starts, so measure the
+    // elapsed time directly from the moment prompt processing began
+    const int64_t t_elapsed_us = ggml_time_us() - t_start_process_prompt;
+
+    // the interval is also the minimum prompt-processing time worth reporting
+    if (t_elapsed_us < (int64_t) stats_interval * 1000000) {
+        return;
+    }
+
+    SLT_INF(*this, "%s\n", stats_row_prompt_processing(n_prompt_tokens_processed, n_prompt_tokens, t_elapsed_us).c_str());
+}
+
+// Snapshot the per-slot stats for the stats thread. Called from the queue thread only, at
+// points where the slot state is consistent (see the call sites in update_slots() and
+// release_slot_after_final_response()).
+void server_context::publish_slot_stats() {
+    std::lock_guard<std::mutex> lock(stats_mutex);
+
+    if (stats_snapshots.size() != slots.size()) {
+        stats_snapshots.resize(slots.size());
+    }
+
+    for (size_t i = 0; i < slots.size(); ++i) {
+        const server_slot & slot = slots[i];
+        slot_stats_snapshot & snap = stats_snapshots[i];
+
+        snap.id      = slot.id;
+        snap.task_id = slot.task != nullptr ? slot.task->id : -1;
+
+        snap.n_prompt_tokens         = slot.n_prompt_tokens;
+        snap.n_prompt_tokens_decoded = slot.n_prompt_tokens_processed;
+        snap.n_decoded               = slot.n_decoded;
+        snap.t_start_process_prompt  = slot.t_start_process_prompt;
+        snap.t_start_generation      = slot.t_start_generation;
+
+        if (!slot.print_stats) {
+            snap.phase = SLOT_STATS_IDLE;
+            continue;
+        }
+
+        if (slot.prompt_batch_i0 >= 0) {
+            // the slot has a prompt chunk queued for the decode that is about to run: it is
+            // not decoded yet, so only count the tokens of the previously decoded chunks
+            const int32_t n_in_flight = slot.prompt_batch_i1 - slot.prompt_batch_i0;
+            snap.n_prompt_tokens_decoded = std::max(0, slot.n_prompt_tokens_processed - n_in_flight);
+            snap.phase = SLOT_STATS_PROMPT;
+        } else if (slot.state == SLOT_STATE_PROCESSING && slot.t_start_generation != 0) {
+            snap.phase = SLOT_STATS_GENERATION;
+        } else {
+            // waiting for its prompt to be queued, embedding/decision task, or already released
+            snap.phase = SLOT_STATS_IDLE;
+        }
+    }
+}
+
+// Periodic per-slot stats, printed by the stats thread every gpt_params::log_stats_interval
+// seconds. The rows are built from the published snapshots, never from the slots directly.
+void server_context::print_periodic_stats() {
+    const int32_t interval_s = params_base.log_stats_interval;
+    if (interval_s <= 0) {
+        return;
+    }
+
+    std::vector<slot_stats_snapshot> snapshots;
+    {
+        std::lock_guard<std::mutex> lock(stats_mutex);
+        snapshots = stats_snapshots;
+    }
+
+    if (stats_windows.size() != snapshots.size()) {
+        stats_windows.assign(snapshots.size(), slot_stats_window());
+    }
+
+    const int64_t t_now = ggml_time_us();
+
+    for (size_t i = 0; i < snapshots.size(); ++i) {
+        const slot_stats_snapshot & snap = snapshots[i];
+        slot_stats_window & win = stats_windows[i];
+
+        if (snap.phase == SLOT_STATS_PROMPT) {
+            win.in_generation = false;
+            log_stats_row("print_timings_pp", snap.id, snap.task_id,
+                stats_row_prompt_processing(snap.n_prompt_tokens_decoded, snap.n_prompt_tokens,
+                    t_now - snap.t_start_process_prompt));
+            continue;
+        }
+
+        if (snap.phase == SLOT_STATS_GENERATION) {
+            // the window starts at the first decoded token and then runs from one row to the
+            // next, so that tg_<interval>s always covers one interval
+            if (!win.in_generation) {
+                win.in_generation = true;
+                win.t_last        = snap.t_start_generation;
+                win.n_gen_last    = 0;
+            }
+
+            if (snap.n_decoded < 100) {
+                // as upstream: not enough decoded tokens to average over yet
+                continue;
+            }
+
+            const double t_window  = t_now > win.t_last ? (double)(t_now - win.t_last) / 1e6 : 0.0;
+            const double tg_window = t_window > 0.0 ? (snap.n_decoded - win.n_gen_last) / t_window : 0.0;
+            const double t_gen     = (double)(t_now - snap.t_start_generation) / 1e6;
+
+            win.t_last     = t_now;
+            win.n_gen_last = snap.n_decoded;
+
+            log_stats_row("print_timings_tg", snap.id, snap.task_id,
+                stats_row_generation(snap.n_decoded, t_gen, tg_window, interval_s));
+            continue;
+        }
+
+        win.in_generation = false;
+        win.t_last        = 0;
+        win.n_gen_last    = 0;
+    }
+}
