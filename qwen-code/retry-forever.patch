+/**
+ * Fixed-interval persistent retry (unattended gateway mode).
+ *
+ * When QWEN_CODE_RETRY_FIXED_MS is set to a positive number of milliseconds,
+ * persistent mode is widened and pinned:
+ *  - every error that is neither an abort nor an authentication/access-denied
+ *    failure (HTTP 401/403 or the credential/billing provider codes relayed
+ *    without a status) enters the unbounded persistent loop — any status, any
+ *    error class, caller-supplied shouldRetryOnError predicates cannot veto it;
+ *  - each wait is exactly this many milliseconds — provider Retry-After and
+ *    the exponential ladder are both bypassed;
+ *  - the transient-quota fast-fails (Qwen OAuth tier, allocated-quota,
+ *    permanent quota exhaustion) become retryable instead of terminal.
+ * Authentication and access-denied failures stay fail-fast: the classifier
+ * marks them so and the patch never widens past that verdict.
+ */
+function getPersistentFixedDelayMs(): number | null {
+  const raw = process.env['QWEN_CODE_RETRY_FIXED_MS'];
+  if (raw === undefined || raw.trim() === '') return null;
+  const value = Number(raw);
+  if (!Number.isFinite(value) || value < 100) return null;
+  // Never exceed the setTimeout ceiling (a larger delay would fire immediately).
+  return Math.min(Math.floor(value), 2_147_483_647);
+}
